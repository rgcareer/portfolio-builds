# Dependencies
node_modules/

# Build output
dist/
**/dist/
site/dist/
.astro/

# Local data — the harvested mirror contains live hostile payloads (prompt-injection,
# secret-scanner tripwires) and the SQLite DB carries the never-published anon_salt.
# This directory MUST NEVER enter git history. `/data*/` catches Finder-copy variants
# ("data 2/") too; the site's published JSON (site/src/data, site/public/data) is NOT
# under a root data*/ path, so it stays tracked.
/data*/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.log
