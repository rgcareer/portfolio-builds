{
  "name": "@rgcareer/llm-cost-autopilot",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Attributes every LLM call to a purpose and budget, prices it with the vendor’s verified cache/batch multipliers, and reports what each policy saved on real traffic as dollars with intervals.",
  "license": "MIT",
  "author": "Ryan (Get Smart AI)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgcareer/portfolio-builds.git",
    "directory": "packages/llm-cost-autopilot"
  },
  "homepage": "https://github.com/rgcareer/portfolio-builds/tree/main/packages/llm-cost-autopilot#readme",
  "bugs": {
    "url": "https://github.com/rgcareer/portfolio-builds/issues"
  },
  "keywords": [
    "llm",
    "cost",
    "pricing",
    "anthropic",
    "prompt-caching",
    "finops",
    "budget"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "llm-cost": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "protocol",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "vitest run packages/llm-cost-autopilot",
    "lca": "node --import tsx src/cli.ts",
    "lca:live": "node --env-file-if-exists=../../.env --import tsx src/cli.ts"
  },
  "dependencies": {
    "citty": "0.2.2"
  },
  "devDependencies": {
    "@portfolio-builds/shared": "0.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
