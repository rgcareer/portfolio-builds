# Names only - never commit real values. The build session never reads the real env file.
# Copy this to a file named ".env" at the repo root and fill in by hand.

# Anthropic API key for LLM calls (every call goes through packages/shared's gateway).
ANTHROPIC_API_KEY=

# Per-run spend cap in USD. 0 (default) = mock mode: no real LLM calls are made.
# Ryan raises this per piece after seeing the mock-run cost estimate.
PB_SPEND_CAP_USD=0

# HMAC salt for anonymization (ids, company tokens). Never committed, never published.
PB_ANON_SALT=

# GitHub token for Skillcheck's full-cohort harvest. Unauthenticated search is enough for
# the Onboarding Transfer Rate corpus seed.
GITHUB_TOKEN=
