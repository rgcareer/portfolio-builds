# Dependencies
node_modules/

# Build output
dist/
**/dist/
.astro/
.vite-temp/

# Env / secrets - the build session never reads the env file
.env
.env.*
!.env.example

# Local databases (the shared cost ledger, per-piece work dbs) - never in history
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Scratch
*.tmp
evidence/*.tmp

# OS / editor
.DS_Store
*.log

# app-created settings dirs inside data trees are never data
packages/*/data/**/.claude/

# Local embedding model weights (semantic-cache) - never in history
packages/*/.model-cache/

# Project-local skill wiring: keep the conventions skill, ignore the machine-specific
# archived-skill symlinks (re-created per machine from ~/.claude/skills-archive).
/.claude/skills/*
!/.claude/skills/portfolio-builds-conventions
